# Program to add two matrices

# Create two matrices
matrix1 = [
    [1, 2, 3],
    [4, 5, 6]
]

matrix2 = [
    [7, 8, 9],
    [10, 11, 12]
]

# Create an empty matrix for the result
result = [
    [0, 0, 0],
    [0, 0, 0]
]

# Add the two matrices
for i in range(2):
    for j in range(3):
        result[i][j] = matrix1[i][j] + matrix2[i][j]

# Display the matrices
print("Matrix 1:")
for row in matrix1:
    print(row)

print("\nMatrix 2:")
for row in matrix2:
    print(row)

print("\nAddition of two matrices:")
for row in result:
    print(row)
